source 'https://cdn.cocoapods.org/'

platform :ios, '11.0'

# 示例固定使用优酷 6.3.7 正式版；历史 Tag、Release 和资产保持不可变。
# 候选公开 API 方法签名不变。UIScene 展示、落地页、外跳回流、曝光和 UI 生命周期绑定实际来源 window/Scene；
# 无来源时只允许唯一且明确的前台应用 Scene，不跨 Scene 随机兜底，独立落地页始终属于来源 Scene。
# 开屏 rootVC 仍须入窗；Scene 宿主的 customWindow 须可见、尺寸有限且为正、已关联且与 rootVC.window 同 Scene，
# 可为非 key、高 windowLevel、无 rootVC；非法输入展示失败，修正后可重试。正式 Tag、Release 和资产以同版本发布记录为准。

target 'IFLYADLibSimple' do
  use_frameworks!

  # 优酷 Model B 单包：只含开屏、插屏和自渲染信息流，模块及公开 API 仍为 IFLYADLib / IFLY*。
  pod 'YKIFLYADLib',
      :podspec => 'https://raw.githubusercontent.com/LJMcarryu/YKIFLYADLib_iOS/6.3.7/YKIFLYADLib.podspec'
end
